# === True Capability Validator — Environment Variables ===

# GitHub Personal Access Token (for API rate limit boost: 60 → 5000 req/hr)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Google Gemini API Key (for LLM-powered scoring)
# Generate at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
UPLOAD_DIR=./uploads
DATABASE_URL=sqlite+aiosqlite:///./data/validator.db
MAX_UPLOAD_SIZE_MB=10
